# Copy to .env and replace every development-only value before startup.
POSTGRES_DB=c2hunter
POSTGRES_USER=c2hunter
POSTGRES_PASSWORD=change-me-postgres
CLICKHOUSE_DB=c2hunter
CLICKHOUSE_USER=c2hunter
CLICKHOUSE_PASSWORD=change-me-clickhouse
MINIO_ROOT_USER=c2hunter-dev
MINIO_ROOT_PASSWORD=change-me-minio-at-least-8-characters
C2HUNTER_S3_BUCKET=c2hunter
CONTROLLER_PORT=8000
WEB_PORT=8080
C2HUNTER_ENVIRONMENT=development
C2HUNTER_PCAP_UPLOAD_MAX_BYTES=524288000
C2HUNTER_PCAP_UPLOAD_MAX_PACKETS=2000000
# Stage 9 offline structural indexing inherits the upload packet ceiling when omitted.
# C2HUNTER_PCAP_OFFSET_INDEX_MAX_PACKETS=2000000
C2HUNTER_PCAP_OFFSET_INDEX_MAX_INTERFACES=4096
C2HUNTER_PCAP_OFFSET_INDEX_BATCH_SIZE=1000
# Bounds for explicitly invoked cleanup of abandoned structural-index staging generations.
C2HUNTER_PCAP_OFFSET_INDEX_STAGING_MAX_AGE_SECONDS=3600
C2HUNTER_PCAP_OFFSET_INDEX_CLEANUP_BATCH_SIZE=100
# Stage 10: optional controller-side metadata for finalized retained LIVE segments.
C2HUNTER_PCAP_OFFSET_INDEX_LIVE_ENABLED=true
C2HUNTER_PCAP_OFFSET_INDEX_QUEUE_CAPACITY=100
C2HUNTER_PCAP_OFFSET_INDEX_WORKER_CONCURRENCY=1
C2HUNTER_PCAP_OFFSET_INDEX_LEASE_SECONDS=120
C2HUNTER_PCAP_OFFSET_INDEX_LEASE_RENEW_SECONDS=30
C2HUNTER_PCAP_OFFSET_INDEX_MAX_ATTEMPTS=3
C2HUNTER_PCAP_OFFSET_INDEX_RETRY_BASE_SECONDS=5
C2HUNTER_PCAP_OFFSET_INDEX_JOB_TIMEOUT_SECONDS=1800
C2HUNTER_PCAP_OFFSET_INDEX_RECONCILE_INTERVAL_SECONDS=30
C2HUNTER_PCAP_OFFSET_INDEX_RECONCILE_BATCH_SIZE=100
C2HUNTER_PCAP_OFFSET_INDEX_TERMINAL_RETENTION_SECONDS=604800
C2HUNTER_PCAP_OFFSET_INDEX_TERMINAL_CLEANUP_BATCH_SIZE=100
C2HUNTER_PCAP_OFFSET_INDEX_SHUTDOWN_GRACE_SECONDS=30
C2HUNTER_PCAP_OFFSET_INDEX_METRICS_PORT=9104
# Stage 11 packet-posting index. Disabled by default; backfill is declaration-only.
C2HUNTER_PCAP_POSTING_INDEX_ENABLED=false
C2HUNTER_PCAP_POSTING_INDEX_QUEUE_CAPACITY=100
C2HUNTER_PCAP_POSTING_INDEX_WORKER_CONCURRENCY=1
C2HUNTER_PCAP_POSTING_INDEX_LEASE_SECONDS=120
C2HUNTER_PCAP_POSTING_INDEX_HEARTBEAT_INTERVAL_SECONDS=30
C2HUNTER_PCAP_POSTING_INDEX_MAX_ATTEMPTS=3
C2HUNTER_PCAP_POSTING_INDEX_RETRY_BASE_SECONDS=5
C2HUNTER_PCAP_POSTING_INDEX_OPERATION_TIMEOUT_SECONDS=1800
C2HUNTER_PCAP_POSTING_INDEX_POLL_INTERVAL_SECONDS=0.25
C2HUNTER_PCAP_POSTING_INDEX_RECONCILE_INTERVAL_SECONDS=30
C2HUNTER_PCAP_POSTING_INDEX_RECONCILE_BATCH_SIZE=100
C2HUNTER_PCAP_POSTING_INDEX_STAGING_MAX_AGE_SECONDS=3600
C2HUNTER_PCAP_POSTING_INDEX_STAGING_CLEANUP_BATCH_SIZE=100
C2HUNTER_PCAP_POSTING_INDEX_TERMINAL_RETENTION_SECONDS=604800
C2HUNTER_PCAP_POSTING_INDEX_TERMINAL_CLEANUP_BATCH_SIZE=100
C2HUNTER_PCAP_POSTING_INDEX_BUILD_MAX_PACKETS=10000000
C2HUNTER_PCAP_POSTING_INDEX_BUILD_MAX_MEMBERSHIPS=20000000
C2HUNTER_PCAP_POSTING_INDEX_BUILD_MAX_DISTINCT_KEYS=1000000
C2HUNTER_PCAP_POSTING_INDEX_BUILD_MAX_ENCODED_BYTES=536870912
C2HUNTER_PCAP_POSTING_INDEX_BUILD_MAX_CHUNKS=1000000
C2HUNTER_PCAP_POSTING_INDEX_BUILD_BATCH_SIZE=1000
C2HUNTER_PCAP_POSTING_INDEX_QUERY_MAX_OPERATIONS=100000
C2HUNTER_PCAP_POSTING_INDEX_QUERY_MAX_RESULT_ORDINALS=100000
C2HUNTER_PCAP_POSTING_INDEX_QUERY_MAX_DECODED_MEMBERSHIPS=100000
C2HUNTER_PCAP_POSTING_INDEX_QUERY_MAX_DIRECTORY_CHUNKS=100000
C2HUNTER_PCAP_POSTING_INDEX_QUERY_MAX_DICTIONARY_TERMS=100000
C2HUNTER_PCAP_POSTING_INDEX_METRICS_ENABLED=true
C2HUNTER_PCAP_POSTING_INDEX_BACKFILL_ENABLED=false
C2HUNTER_PCAP_POSTING_INDEX_BACKFILL_BATCH_SIZE=100
# Stage 12 selected-range rollout. Active covers all eligible exports; only shadow is sampled.
C2HUNTER_PCAP_INDEXED_EXPORT_MODE=off
C2HUNTER_PCAP_INDEXED_EXPORT_CANARY_BASIS_POINTS=0
C2HUNTER_PCAP_INDEXED_EXPORT_MAX_SOURCES=128
C2HUNTER_PCAP_INDEXED_EXPORT_MAX_GAP_BYTES=65536
C2HUNTER_PCAP_INDEXED_EXPORT_MAX_RANGE_BYTES=8388608
C2HUNTER_PCAP_INDEXED_EXPORT_MAX_RANGES=4096
C2HUNTER_PCAP_INDEXED_EXPORT_MAX_TOTAL_FETCHED_BYTES=268435456
C2HUNTER_PCAP_INDEXED_EXPORT_MAX_AMPLIFICATION_NUMERATOR=4
C2HUNTER_PCAP_INDEXED_EXPORT_MAX_AMPLIFICATION_DENOMINATOR=1
C2HUNTER_PCAP_INDEXED_EXPORT_MAX_SOURCE_FRACTION_NUMERATOR=1
C2HUNTER_PCAP_INDEXED_EXPORT_MAX_SOURCE_FRACTION_DENOMINATOR=2
# Export byte and packet settings inherit the upload ceilings when omitted.
# Uncomment only to apply an independent export ceiling.
# C2HUNTER_PCAP_EXPORT_MAX_BYTES=524288000
# C2HUNTER_PCAP_EXPORT_SCAN_MAX_BYTES=524288000
# C2HUNTER_PCAP_EXPORT_SCAN_MAX_PACKETS=2000000
# Synchronous exports are memory-intensive; raise only after capacity testing.
C2HUNTER_PCAP_EXPORT_MAX_CONCURRENT=1
# Per-spool in-memory threshold (two spools overlap during replay); default 8 MiB.
C2HUNTER_PCAP_EXPORT_SPOOL_MAX_MEMORY_BYTES=8388608
# Optional host directory for rolled temporary capture spools.
# C2HUNTER_PCAP_EXPORT_SPOOL_DIRECTORY=/var/tmp/c2hunter
# Temporary construction rollback switch; streaming never retries legacy after a failure.
C2HUNTER_PCAP_EXPORT_PIPELINE=streaming
# Temporary artifact persistence/download rollback switch; streaming is the default.
C2HUNTER_PCAP_ARTIFACT_IO=streaming
# Download validation spool threshold; each concurrent download may roll to disk after 8 MiB.
C2HUNTER_PCAP_DOWNLOAD_SPOOL_MAX_MEMORY_BYTES=8388608
# Optional directory for rolled download-validation spools; blank uses the system temp directory.
# C2HUNTER_PCAP_DOWNLOAD_SPOOL_DIRECTORY=/var/tmp/c2hunter
# Hybrid admission keeps small trusted sources synchronous and queues larger/unknown work.
# sync_only stops new async admission; keep workers running until accepted jobs drain.
C2HUNTER_PCAP_EXPORT_EXECUTION_MODE=hybrid
C2HUNTER_PCAP_EXPORT_SYNC_MAX_SOURCE_BYTES=33554432
C2HUNTER_PCAP_EXPORT_SYNC_MAX_PACKETS=100000
C2HUNTER_PCAP_EXPORT_ASYNC_WORKER_CONCURRENCY=2
C2HUNTER_PCAP_EXPORT_QUEUE_CAPACITY=100
C2HUNTER_PCAP_EXPORT_PER_PRINCIPAL_ACTIVE_LIMIT=10
C2HUNTER_PCAP_EXPORT_LEASE_SECONDS=120
C2HUNTER_PCAP_EXPORT_LEASE_RENEW_SECONDS=30
C2HUNTER_PCAP_EXPORT_MAX_ATTEMPTS=3
C2HUNTER_PCAP_EXPORT_RETRY_BASE_SECONDS=5
C2HUNTER_PCAP_EXPORT_JOB_TIMEOUT_SECONDS=1800
C2HUNTER_PCAP_EXPORT_TERMINAL_RETENTION_SECONDS=604800
C2HUNTER_PCAP_EXPORT_TERMINAL_MAX_COUNT=10000
C2HUNTER_PCAP_EXPORT_TERMINAL_MAX_ARTIFACT_BYTES=107374182400
C2HUNTER_PCAP_EXPORT_ORPHAN_MAX_AGE_SECONDS=3600
C2HUNTER_PCAP_EXPORT_METRICS_PORT=9103
# Never enable this in staging or production.
C2HUNTER_DEV_LOGIN_ENABLED=true
# Development login session TTL. Default: 8 hours; maximum accepted value: 24 hours.
C2HUNTER_DEV_TOKEN_TTL_SECONDS=28800
# Human API authentication is fail-closed outside isolated tests.
C2HUNTER_API_AUTH_REQUIRED=true
# Set only SHA-256 digests here; never put plaintext bearer tokens in this file.
C2HUNTER_VIEWER_TOKEN_SHA256=
C2HUNTER_ANALYST_TOKEN_SHA256=
C2HUNTER_ADMIN_TOKEN_SHA256=
C2HUNTER_RATE_LIMIT_WINDOW_SECONDS=60
C2HUNTER_DEV_LOGIN_RATE_LIMIT=10
C2HUNTER_ENROLLMENT_CLAIM_RATE_LIMIT=10
C2HUNTER_ANALYSIS_JOB_RATE_LIMIT=30
# Trust only the immediate reverse proxy. Compose defaults to its fixed Web container /32.
C2HUNTER_TRUSTED_PROXY_CIDRS=172.30.0.10/32
# Keep disabled unless the dedicated AI worker and selected local model are ready.
C2HUNTER_AI_ANALYSIS_ENABLED=false
C2HUNTER_AI_MODEL_PROVIDER=fake
C2HUNTER_AI_MODEL_BASE_URL=http://host.docker.internal:11434
# openai-compatible public endpoints emit a startup warning because Evidence metadata leaves the host.
C2HUNTER_AI_MODEL_NAME=qwen3.6-agent:256k
C2HUNTER_AI_MODEL_API_KEY=
C2HUNTER_AI_MODEL_TIMEOUT_SECONDS=120
C2HUNTER_AI_MODEL_RETRIES=1
C2HUNTER_AI_MODEL_TEMPERATURE=0.1
C2HUNTER_AI_MODEL_CONTEXT_TOKENS=16384
C2HUNTER_AI_MODEL_MAX_OUTPUT_TOKENS=4096
C2HUNTER_AI_METRICS_PORT=9102
# Optional candidate enrichment integrations. Inject real secrets from a secret manager.
C2HUNTER_VIRUSTOTAL_API_KEY=
C2HUNTER_ABUSEIPDB_API_KEY=
C2HUNTER_THREAT_INTEL_TIMEOUT_SECONDS=10
C2HUNTER_THREAT_INTEL_REQUEST_DELAY_SECONDS=1
C2HUNTER_ABUSEIPDB_MAX_AGE_DAYS=90
C2HUNTER_MISP_URL=
C2HUNTER_MISP_API_KEY=
C2HUNTER_MISP_DEFAULT_EVENT_ID=
C2HUNTER_MISP_VERIFY_TLS=true
